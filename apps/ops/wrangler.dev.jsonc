{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drape-ops-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ops-dev.drapeon.co/*",
      "zone_name": "drapeon.co"
    }
  ],
  "vars": {
    "DRAPE_OPS_ENV": "development",
    "DRAPE_TAILOR_CLAIMS_ENABLED": "0",
    "DRAPE_EXPECTED_SUPABASE_PROJECT_REF": "pqptfuqogvrajozfsqzi",
    "NEXT_PUBLIC_SITE_URL": "https://ops-dev.drapeon.co",
    "NEXT_PUBLIC_SUPABASE_URL": "https://pqptfuqogvrajozfsqzi.supabase.co",
    "CF_ACCESS_TEAM_DOMAIN": "drapeon.cloudflareaccess.com",
    "OPS_ALLOWED_EMAILS": "dimowoope@gmail.com,koleosho530@gmail.com",
    "OPS_HOSTNAME": "ops-dev.drapeon.co",
    "OPS_CANONICAL_ORIGIN": "https://ops-dev.drapeon.co"
  },
  "secrets": {
    "required": [
      "CF_ACCESS_AUD",
      "CF_ACCESS_SENSITIVE_AUD",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY"
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
